#!/usr/bin/env bash
#MISE description="Import secrets from a JSON bundle (stdin)"
#USAGE flag "-p --provider <provider>" help="Provider: keychain, 1password, or sops (overrides SECRETS_PROVIDER)"
#USAGE long_about "Import secrets from a plain JSON bundle read from stdin.\n\nKeys are stored exactly as they appear in the JSON.\nIf the bundle is GPG-encrypted, decrypt it first.\n\nExamples:\n  secrets export --prefix baby-joel | secrets import -p keychain\n  gpg -d bundle.gpg | secrets import -p keychain"

set -eo pipefail

PROVIDER="${usage_provider:-${SECRETS_PROVIDER:-}}"
LIB_DIR="${MISE_CONFIG_ROOT:?}/lib"

if [ -z "$PROVIDER" ]; then
  echo "ERROR: No secret provider specified." >&2
  echo "       Set SECRETS_PROVIDER=keychain|1password|sops, or use --provider <provider>" >&2
  exit 1
fi

if [ -t 0 ]; then
  echo "ERROR: No input. Pipe a JSON bundle via stdin." >&2
  echo "       Usage: secrets export --prefix <prefix> | secrets import --provider <target>" >&2
  exit 1
fi

if [ "$PROVIDER" = sops ]; then
  PYTHONPATH="$LIB_DIR" exec python3 -m providers.sops import
fi

# Validate all names/types/duplicates before the first nontransactional write.
# Only JSON (not raw values) is captured, so trailing newlines remain escaped.
json=$(python3 "$LIB_DIR/document.py") || exit 1

# Source the appropriate provider
case "$PROVIDER" in
  keychain)
    source "$LIB_DIR/providers/keychain.sh"
    set_fn="keychain_set"
    ;;
  1password)
    source "$LIB_DIR/providers/onepassword/provider.sh"
    set_fn="op_set"
    ;;
  *)
    echo "ERROR: Unknown provider: $PROVIDER" >&2
    exit 1
    ;;
esac

# Iterate over keys and import each one
count=0
errors=0
while IFS= read -r key; do
  [ -z "$key" ] && continue
  printf '%s' "$json" | jq -jr --arg k "$key" '.[$k]' | "$set_fn" "$key" || {
    echo "WARNING: Failed to store key=$key, skipping" >&2
    errors=$((errors + 1))
    continue
  }
  count=$((count + 1))
done < <(echo "$json" | jq -r 'keys[]')

echo "Imported $count secret(s) into provider=$PROVIDER"
if [ "$errors" -gt 0 ]; then
  echo "WARNING: $errors key(s) failed to import; successful writes remain." >&2
  exit 1
fi
