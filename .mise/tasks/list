#!/usr/bin/env bash
#MISE description="List stored secrets"
#USAGE flag "--prefix <prefix>" help="Filter keys by prefix (e.g., baby-joel). Uses startswith matching — include trailing / for exact prefix boundaries."
#USAGE flag "-p --provider <provider>" help="Provider: keychain, 1password, or sops (overrides SECRETS_PROVIDER)"

set -eo pipefail

PREFIX="${usage_prefix:-}"
PROVIDER="${usage_provider:-${SECRETS_PROVIDER:-}}"
LIB_DIR="${MISE_CONFIG_ROOT:?}/lib"

if [ -z "$PROVIDER" ]; then
  echo "Usage: secrets list [--prefix <prefix>] [--provider <provider>]" >&2
  echo "" >&2
  echo "Set SECRETS_PROVIDER=keychain|1password|sops (or --provider) to list stored secrets." >&2
  exit 1
fi

case "$PROVIDER" in
  keychain)
    source "$LIB_DIR/providers/keychain.sh"
    echo "Keychain secrets${PREFIX:+ (prefix: $PREFIX)}:"
    keychain_list "$PREFIX"
    ;;
  1password)
    source "$LIB_DIR/providers/onepassword/provider.sh"
    echo "1Password secrets${PREFIX:+ (prefix: $PREFIX)}:"
    op_list "$PREFIX"
    ;;
  sops)
    PYTHONPATH="$LIB_DIR" python3 -m providers.sops list "$PREFIX"
    ;;
  *)
    echo "ERROR: Unknown provider: $PROVIDER" >&2
    echo "       Valid providers: keychain, 1password, sops" >&2
    exit 1
    ;;
esac
