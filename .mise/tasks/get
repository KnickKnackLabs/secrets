#!/usr/bin/env bash
#MISE description="Retrieve a secret"
#USAGE arg "<key>" help="Secret key (e.g., baby-joel/github-pat)"
#USAGE flag "-p --provider <provider>" help="Provider: keychain, 1password, sops, or env (overrides SECRETS_PROVIDER)"

set -eo pipefail

KEY="${usage_key:?}"
PROVIDER="${usage_provider:-${SECRETS_PROVIDER:-}}"
LIB_DIR="${MISE_CONFIG_ROOT:?}/lib"

if [ -z "$PROVIDER" ]; then
  echo "ERROR: No secret provider specified." >&2
  echo "       Set SECRETS_PROVIDER=keychain|1password|sops|env, or use --provider <provider>" >&2
  exit 1
fi

case "$PROVIDER" in
  keychain)
    source "$LIB_DIR/providers/keychain.sh"
    keychain_get "$KEY"
    ;;
  1password)
    source "$LIB_DIR/providers/onepassword/provider.sh"
    op_get "$KEY"
    ;;
  sops)
    PYTHONPATH="$LIB_DIR" python3 -m providers.sops get "$KEY"
    ;;
  env)
    source "$LIB_DIR/providers/env.sh"
    env_get "$KEY"
    ;;
  *)
    echo "ERROR: Unknown provider: $PROVIDER" >&2
    echo "       Valid providers: keychain, 1password, sops, env" >&2
    exit 1
    ;;
esac
