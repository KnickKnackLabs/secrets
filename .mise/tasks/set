#!/usr/bin/env bash
#MISE description="Store a secret"
#USAGE arg "<key>" help="Secret key (e.g., baby-joel/github-pat)"
#USAGE flag "-v --value <value>" help="Value to store (prefer stdin to avoid shell history/process arguments)"
#USAGE flag "-p --provider <provider>" help="Provider: keychain, 1password, or sops (overrides SECRETS_PROVIDER)"

set -eo pipefail

KEY="${usage_key:?}"
PROVIDER="${usage_provider:-${SECRETS_PROVIDER:-}}"
LIB_DIR="${MISE_CONFIG_ROOT:?}/lib"

if [ -z "$PROVIDER" ]; then
  echo "ERROR: No secret provider specified." >&2
  echo "       Set SECRETS_PROVIDER=keychain|1password|sops, or use --provider <provider>" >&2
  exit 1
fi

source "$LIB_DIR/values.sh"
secrets_require_input
case "$PROVIDER" in
  keychain)
    source "$LIB_DIR/providers/keychain.sh"
    secrets_input | keychain_set "$KEY"
    ;;
  1password)
    source "$LIB_DIR/providers/onepassword/provider.sh"
    secrets_input | op_set "$KEY"
    ;;
  sops)
    secrets_input | PYTHONPATH="$LIB_DIR" python3 -m providers.sops set "$KEY"
    ;;
  *)
    echo "ERROR: Unknown provider: $PROVIDER" >&2
    echo "       Valid providers: keychain, 1password, sops" >&2
    exit 1
    ;;
esac
