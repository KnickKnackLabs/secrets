#!/usr/bin/env bash
#MISE description="Remove a secret"
#USAGE arg "<key>" help="Key name to remove (e.g., baby-joel/github-pat)"
#USAGE flag "-p --provider <provider>" help="Provider: keychain, libsecret, or 1password (overrides SECRETS_PROVIDER)"

set -eo pipefail

KEY="${usage_key:?}"
PROVIDER="${usage_provider:-${SECRETS_PROVIDER:-}}"
LIB_DIR="${MISE_CONFIG_ROOT:?}/lib"

if [ -z "$PROVIDER" ]; then
  echo "ERROR: No secret provider specified." >&2
  echo "       Set SECRETS_PROVIDER=keychain|libsecret|1password, or use --provider <provider>" >&2
  exit 1
fi

case "$PROVIDER" in
  keychain)
    source "$LIB_DIR/keychain.sh"
    keychain_delete "$KEY"
    ;;
  libsecret)
    source "$LIB_DIR/libsecret.sh"
    libsecret_delete "$KEY"
    ;;
  1password)
    source "$LIB_DIR/1password.sh"
    op_delete "$KEY"
    ;;
  *)
    echo "ERROR: Unknown provider: $PROVIDER" >&2
    echo "       Valid providers: keychain, libsecret, 1password" >&2
    exit 1
    ;;
esac
